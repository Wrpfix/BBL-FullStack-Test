# Backend API base URL (includes /api prefix). Backend listens on 3001 in
# dev — 3000 is reserved for this frontend's Vite dev server because the
# Auth0 Application's registered callback URL is http://localhost:3000/callback.
VITE_API_BASE_URL=http://localhost:3001/api

# Auth0 (OIDC) tenant config. These are public SPA values (a SPA client ID
# is not a secret — it ships in the bundle either way), kept in env vars so
# they can differ per environment without a code change.
VITE_AUTH0_DOMAIN=dev-yg.us.auth0.com
VITE_AUTH0_CLIENT_ID=H9F6QG5SzTKMv0tbmgxLj9LjG1EKVllA
VITE_AUTH0_AUDIENCE=https://bbl-candidate-test-api
VITE_AUTH0_CALLBACK_URL=http://localhost:3000/callback
