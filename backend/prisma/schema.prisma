// Resource models. See ../../API_DESIGN.md for field/endpoint contracts and
// ../../DECISIONS.md #10 for why ids are autoincrement Int rather than cuid
// strings.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// Internal user record, keyed off the Auth0 `sub` claim. Created via
/// just-in-time provisioning the first time a verified token is seen —
/// see backend/src/auth/jwt.strategy.ts.
model User {
  id       Int    @id @default(autoincrement())
  auth0Sub String @unique
  email    String @unique

  createdAt DateTime @default(now())

  collections Collection[]
  bookmarks   Bookmark[]
}

model Collection {
  id   Int    @id @default(autoincrement())
  name String

  ownerId Int
  owner   User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookmarks Bookmark[]

  /// Unguessable capability token for read-only public sharing (see
  /// backend/src/shared). Null until POST /collections/:id/share is called
  /// for the first time — not generated eagerly on create.
  shareToken String? @unique

  /// Whether the current shareToken (if any) is redeemable via
  /// GET /shared/:token. DELETE /collections/:id/share sets this false AND
  /// nulls shareToken — see CollectionsService.unshare for why.
  shareEnabled Boolean @default(false)

  @@index([ownerId])
}

model Bookmark {
  id    Int     @id @default(autoincrement())
  url   String
  title String
  notes String?

  collectionId Int?
  collection   Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)

  ownerId Int
  owner   User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([collectionId])
}
